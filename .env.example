APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai

# 后台登录令牌签名密钥，至少 32 位随机字符：php -r 'echo bin2hex(random_bytes(32));'
JWT_SECRET=

# 平台密码的加密密钥，64 位十六进制（32 字节）：php -r 'echo bin2hex(random_bytes(32));'
# 一旦有数据就不能再改，也不能丢：换了或丢了，已保存的密码全部无法解密
PASSWORD_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ops
DB_USERNAME=ops
DB_PASSWORD=
