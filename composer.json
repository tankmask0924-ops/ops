{
    "name": "ops/platform-admin",
    "description": "平台账号管理后台：登录、按人分配可见平台、平台账号密码管理",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "^7.1",
        "illuminate/database": "^11.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
